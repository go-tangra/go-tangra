# syntax=docker/dockerfile:1
# [[ .RepoName ]] ([[ .Name ]] service, go-tangra v4) - standalone image.
# Build context: the repository root. Generated from go-freya tools/split/templates/Dockerfile.tmpl.
#
#   docker buildx build --secret id=npm_token,env=NODE_AUTH_TOKEN \
#     --build-arg APP_VERSION=4.0.0 --build-arg VCS_REF=$(git rev-parse HEAD) -t [[ .RepoName ]]:dev .
#
# npm_token is a GitHub token with read:packages for @go-tangra/ui on npm.pkg.github.com.
# It is mounted only for the npm ci step and written to a tmpfs, so it never lands in a layer.
[[- if .HasUI ]]

FROM node:22-alpine AS ui
WORKDIR /src/[[ .UI.Dir ]]
COPY [[ .UI.Dir ]]/package.json [[ .UI.Dir ]]/package-lock.json ./
RUN --mount=type=secret,id=npm_token,required=true \
    --mount=type=tmpfs,target=/run/npmrc \
    --mount=type=cache,target=/root/.npm \
    set -eu; \
    printf '@go-tangra:registry=https://npm.pkg.github.com\n//npm.pkg.github.com/:_authToken=%s\nignore-scripts=true\nfund=false\naudit=false\n' \
      "$(cat /run/secrets/npm_token)" > /run/npmrc/.npmrc; \
    NPM_CONFIG_USERCONFIG=/run/npmrc/.npmrc npm ci --no-audit --no-fund
COPY [[ .UI.Dir ]]/ ./
RUN [[ range $i, $s := .UI.BuildScripts ]][[ if $i ]] && [[ end ]]npm run [[ $s ]][[ end ]]
[[- end ]]

FROM golang:1.26-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src
# GOWORK=off: service repositories never use a go.work; dependencies come from published tags.
ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false GOWORK=off
COPY go.mod go.sum ./
[[- if .SDK ]]
COPY sdk/go.mod sdk/go.sum ./sdk/
[[- end ]]
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
[[- if .HasUI ]]
[[- $ui := .UI.Dir ]]
[[- range .UI.Dist ]]
COPY --from=ui /src/[[ $ui ]]/[[ . ]] ./[[ $ui ]]/[[ . ]]
[[- end ]]
[[- end ]]
ARG APP_VERSION=dev
[[- if not .VersionVar ]]
# NOTE: this service's main package has no `var version` yet; -X main.version is a no-op
# until one is added (per-repo follow-up).
[[- end ]]
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    [[ range $i, $b := .Binaries ]][[ if $i ]] \
 && [[ end ]]go build -trimpath[[ if $b.Tags ]] -tags "[[ $b.Tags ]]"[[ end ]] -ldflags "-s -w -X main.version=${APP_VERSION}" -o /out/[[ $b.Name ]] [[ $b.Cmd ]][[ end ]]

FROM alpine:3.20
ARG APP_VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/[[ .Repo ]]" \
      org.opencontainers.image.title="[[ .RepoName ]]" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"
RUN apk add --no-cache [[ join .Runtime.APK " " ]] && adduser -D -u 10001 app
COPY --from=build [[ binNames .Binaries ]] /usr/local/bin/
[[- range .Runtime.Setcap ]]
RUN setcap [[ . ]]
[[- end ]]
COPY deploy /app/deploy
WORKDIR /app
USER app
[[- range .Runtime.Expose ]]
EXPOSE [[ . ]]
[[- end ]]
ENTRYPOINT [[ jsonArray .Runtime.Entrypoint ]]
[[- if .Runtime.Cmd ]]
CMD [[ jsonArray .Runtime.Cmd ]]
[[- end ]]
