# Freya
.dev/
.artifacts/
coverage.out
*.test
*.out
*.exe
bin/
vendor/
# secrets must never be committed
*.key
*.pem
!**/testdata/**/*.pem
# editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.tmp
# services
services/*/console/node_modules/
services/*/console/dist/
services/*/console/dist-remote/
services/*/.artifacts/
services/*/shell/node_modules/
services/*/shell/dist/
services/*/ui/node_modules/
services/*/ui/dist/
services/*/ui/test-results/
services/*/ui/playwright-report/
services/warden/deploy/.vault/

services/notification/deploy/kek.dev
services/notification/ui/dist-remote/
services/notification/coverage.out
# local tool state / stray builds
.playwright-mcp/
.spec-router/
# service binaries built at a service root (files only; cmd/<x>svc source dirs stay tracked)
/services/*/*svc
!/services/*/*svc/
/services/*/inventory-agent
/services/*/inventory-agent.exe
/services/*/lcm-devca
services/*/bin/
services/*/coverage.out
# shared UI kit / npm workspace
node_modules/
ui/kit/dist/
ui/kit/coverage/
ui/kit/catalogue/dist/
ui/kit/test-results/
ui/kit/playwright-report/

# Local per-developer stack overrides (e.g. build a service from a checkout)
deploy/stack/compose.override.yaml
