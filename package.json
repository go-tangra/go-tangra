{
  "name": "go-tangra",
  "private": true,
  "description": "npm workspace for the go-tangra v4 platform front-end: the shared UI kit (@go-tangra/ui) and its static checks.",
  "workspaces": [
    "ui/kit"
  ],
  "scripts": {
    "kit": "npm run build -w ui/kit",
    "lint": "npm run lint -w ui/kit",
    "test": "npm run test:unit -w ui/kit",
    "build": "npm run build -w ui/kit",
    "check": "node ui/scripts/check-duplicates.mjs && node ui/kit/bin/check-no-legacy.mjs --root .",
    "check:self": "node --test ui/scripts/tests/checks.spec.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
