root = true
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
[*.go]
indent_style = tab
[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
[Makefile]
indent_style = tab
# LDAP fuzz/table corpus: files are the exact parser input — a trailing
# newline would invalidate the valid-* fixtures (see testdata/ldap/README.md).
[services/auth/tests/fuzz/testdata/ldap/**]
insert_final_newline = false
trim_trailing_whitespace = false
